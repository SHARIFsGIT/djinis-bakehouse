# Copy to .env and adjust as needed. Defaults work out of the box.

# "dev" or "production". In production the app refuses to start with a
# development SECRET_KEY and logs a warning if the API docs are left on.
APP_ENV=dev

# SQLite by default; any SQLAlchemy URL works (e.g. postgresql://...)
# A relative SQLite path always resolves inside the backend/ folder,
# no matter which directory the server is started from.
DATABASE_URL=sqlite:///./bakehouse.db

# Generate a fresh secret: python -c "import secrets; print(secrets.token_hex(32))"
# (the placeholder below is 32+ bytes so dev runs stay warning-free; the app
# refuses to start in production while any known placeholder is set)
SECRET_KEY=dev-only-secret-change-me-before-production

# Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Business rules — PENDING OWNER APPROVAL as EUR figures (2026-11-05).
# The shop charges euro only (STRIPE_CURRENCY=eur). The old USD values
# (8.75% US sales tax, $5.99 delivery, $50 free-delivery threshold, $150
# VIP spend) are NOT approved EUR values and ship unset. While SHIPPING_FEE
# and FREE_SHIPPING_THRESHOLD are unset, checkout is PAUSED fail-closed
# (quotes and placement refuse with 503). TAX_RATE unset = no tax line
# (VAT treatment pending professional review — never a 0%-VAT claim).
# VIP_SPEND_THRESHOLD unset = loyalty tiers ride on order counts alone.
# Set each explicitly once approved, e.g.:
# TAX_RATE=
# SHIPPING_FEE=
# FREE_SHIPPING_THRESHOLD=
# VIP_SPEND_THRESHOLD=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Static files (products, logo, photos) relative to backend/
STATIC_DIR=static

# Serve frontend/dist from FastAPI (single-process deploys). Set to false
# when a separate web server (nginx, Vercel...) hosts the frontend instead.
SERVE_FRONTEND_DIST=true

# Interactive API docs at /api/docs — switch off in production if unwanted
ENABLE_DOCS=true

# Abuse brakes: attempts per minute per IP
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5

# "Continue with Facebook" on the login page. Create the app at
# developers.facebook.com (add the Facebook Login product), put
# https://<your-domain>/api/auth/facebook/callback under "Valid OAuth
# Redirect URIs", then set both values — the button appears once they are.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_API_VERSION=v23.0

# Phone sign-in codes over SMS, sent through Twilio. All three together
# switch the phone option on; empty = codes are logged instead of sent.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Fresh-database seeding. The catalog (categories, products, vouchers) always
# seeds; demo customers/orders/reviews seed only when this is true. Unset =
# yes in dev, no in production (production refuses it outright).
# SEED_DEMO_DATA=false

# The first admin on a fresh database — required when demo data is off
# (i.e. in production). Use your real email and a strong password.
# ADMIN_EMAIL=you@yourdomain.com
# ADMIN_PASSWORD=change-me-to-something-strong

# Where uploaded photos (admin product photos, avatars) are stored. Leave
# empty for backend/static/uploads. On platforms with ephemeral filesystems
# (Render, Railway, ...), point this at a persistent disk so photos survive
# redeploys, e.g. UPLOADS_DIR=/data/uploads
# UPLOADS_DIR=

# Online card payments via Stripe (Sandbox/test keys only — never Live).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# The shop's one charge currency. EUR only since the 2026-11-05 owner
# decision; any other value pauses checkout fail-closed.
STRIPE_CURRENCY=eur

# Dev launcher only (python run.py); production should use the uvicorn CLI
# HOST=127.0.0.1
# PORT=8000
