# Copy to .env and adjust as needed. Defaults work out of the box.

# "dev" or "production". In production the app refuses to start with a
# development SECRET_KEY and logs a warning if the API docs are left on.
APP_ENV=dev

# SQLite by default; any SQLAlchemy URL works (e.g. postgresql://...)
# A relative SQLite path always resolves inside the backend/ folder,
# no matter which directory the server is started from.
DATABASE_URL=sqlite:///./bakehouse.db

# Generate a fresh secret: python -c "import secrets; print(secrets.token_hex(32))"
# (the placeholder below is 32+ bytes so dev runs stay warning-free; the app
# refuses to start in production while any known placeholder is set)
SECRET_KEY=dev-only-secret-change-me-before-production

# Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Business rules — the owner's approved EUR figures (2026-11-06). The
# shop charges euro only (STRIPE_CURRENCY=eur). While SHIPPING_FEE and
# FREE_SHIPPING_THRESHOLD are unset, checkout stays PAUSED fail-closed
# (quotes and placement refuse with 503) — these are the values that open
# it, exactly as approved:
#   delivery €2.99, free from €25.00 (VIP regulars from €15.00), and the
#   exclusive-mode register rate 7% (TAX_RATE=0.07 — the flat register
#   rate; the per-product 7/19 classification and the VAT-inclusive engine
#   stay parked pending the tax adviser, rates seeded in vat_rates).
TAX_RATE=0.07
SHIPPING_FEE=2.99
FREE_SHIPPING_THRESHOLD=25.00
VIP_FREE_DELIVERY_THRESHOLD=15.00
# Pricing mode. "exclusive" (default) — net shelf prices, the register rate
# added at the till. "inclusive" — the German B2C mode: shelf prices are
# gross, VAT is extracted per line (app/vat.py), shipping VAT is allocated
# across the basket's rates, and orders persist full per-line/per-rate
# snapshots. Inclusive mode refuses any purchasable product without an
# approved VAT classification (fail-closed, per product) — classify the
# catalog first: admin Products → the tax-review rail, or review
# GET /api/admin/vat/report. Do not set this until the catalog is
# classified; an invalid value is a boot error.
TAX_MODE=exclusive
# VIP_SPEND_THRESHOLD stays unset — spend-based VIP tiers remain off and
# tiers ride on order counts alone.

# The shop's own clock — an IANA zone name. It decides what "today" is
# for order numbers and for the earliest delivery date a customer may pick,
# and it is the time printed on receipts, emails and CSV exports. The
# server's clock is UTC on most hosts; a bakery's day is not. An unknown
# name is logged and falls back to UTC rather than stopping the shop.
SHOP_TIMEZONE=Europe/Berlin

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Static files (products, logo, photos) relative to backend/
STATIC_DIR=static

# Serve frontend/dist from FastAPI (single-process deploys). Set to false
# when a separate web server (nginx, Vercel...) hosts the frontend instead.
SERVE_FRONTEND_DIST=true

# Interactive API docs at /api/docs — switch off in production if unwanted
ENABLE_DOCS=true

# Abuse brakes: attempts per minute per IP
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5
# Per-account brakes (a signed-in customer, whatever address they come
# from). Orders and reviews count per hour — each order reserves stock and
# rings the desk, each review emails the admins; payment actions (opening a
# pay page, checking a payment) count per minute — each is a call to Stripe
# or PayPal. Generous for a person, tight for a script.
ORDER_RATE_LIMIT=12
REVIEW_RATE_LIMIT=10
PAYMENT_ACTION_RATE_LIMIT=30
# Which header carries the visitor's real address for those brakes. Leave
# empty for the default (the first X-Forwarded-For hop) — which is only
# honest behind a proxy that REPLACES that header; one that appends to it
# lets a caller forge the first hop and walk past every per-address brake.
# If your edge sets an address header itself (Cloudflare: CF-Connecting-IP),
# name it here. Never a header your edge merely passes through.
# CLIENT_IP_HEADER=

# Outgoing email — receipts, order updates, password resets, back-in-stock
# notes, desk alerts and marketing all go through this one SMTP account.
# With SMTP_HOST empty nothing is ever sent: in dev each message is written
# to the log (links included, so every flow stays testable); in production
# only the recipient and subject are logged, and boot says "Email is OFF".
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Djini's Bakehouse <no-reply@yourdomain.com>

# "Continue with Facebook" on the login page. Create the app at
# developers.facebook.com (add the Facebook Login product), put
# https://<your-domain>/api/auth/facebook/callback under "Valid OAuth
# Redirect URIs", then set both values — the button appears once they are.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_API_VERSION=v23.0

# Phone sign-in codes over SMS, sent through Twilio. All three together
# switch the phone option on; empty = codes are logged instead of sent.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Fresh-database seeding. The catalog (categories, products, vouchers) always
# seeds; demo customers/orders/reviews seed only when this is true. Unset =
# yes in dev, no in production (production refuses it outright).
# SEED_DEMO_DATA=false

# The first admin on a fresh database — required when demo data is off
# (i.e. in production). Use your real email and a strong password.
# ADMIN_EMAIL=you@yourdomain.com
# ADMIN_PASSWORD=change-me-to-something-strong

# Where uploaded photos (admin product photos, avatars) are stored. Leave
# empty for backend/static/uploads. On platforms with ephemeral filesystems
# (Render, Railway, ...), point this at a persistent disk so photos survive
# redeploys, e.g. UPLOADS_DIR=/data/uploads
# UPLOADS_DIR=

# ── Online payments ────────────────────────────────────────────────────
# This file is a template: it never holds a real key. Put TEST keys in your
# own .env for development; LIVE keys belong only in the production host's
# secret store (Render → Environment), never in a file in this repository.
# Going live is a procedure, not a variable: docs/operations/PAYMENTS_GO_LIVE.md
# Check any environment with:  python scripts/check_payments.py

# Stripe — cards, wallets and whatever else the Stripe account has switched
# on. The card option appears at checkout the moment the secret key is set.
# The key's own prefix decides the mode: sk_test_… rehearses (no real money,
# checkout says so), sk_live_… charges.
# STRIPE_SECRET_KEY=
# The signing secret (whsec_…) of the webhook endpoint that delivers to
#   https://<your shop>/api/payments/webhook
# Test and live endpoints have different secrets. Without it every Stripe
# webhook is refused: payments then land only when the customer returns or
# the periodic check runs, and refunds or disputes made at Stripe go unseen.
# STRIPE_WEBHOOK_SECRET=
# The shop's one charge currency. EUR only since the 2026-11-05 owner
# decision; any other value pauses checkout fail-closed.
STRIPE_CURRENCY=eur
# Which methods Stripe's page offers. "automatic" (the default) lets Stripe
# decide from what the dashboard has switched on (Settings → Payment
# methods) and what suits the customer, amount and device — Apple Pay and
# Google Pay ride on "card" and show wherever the device has them. A
# comma-separated list only NARROWS that set (it can never make an
# unavailable method appear): card, link, klarna, sepa_debit, ideal,
# bancontact, eps, p24, revolut_pay, amazon_pay, paypal. Unknown names drop
# out with a warning. Methods that settle later (SEPA debit) show as
# "being confirmed" until Stripe's own success or failure event lands.
# STRIPE_PAYMENT_METHODS=automatic

# PayPal — its own option at checkout, beside Stripe. It appears the moment
# both credentials are set (PayPal developer dashboard → Apps & Credentials
# → your REST app). Sandbox and live are two different PayPals with two
# different sets of credentials; PAYPAL_ENVIRONMENT says which one these
# belong to: "sandbox" (the default — rehearsal, no real money) or "live".
# A mismatch is refused by PayPal at the first call; nothing is charged.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENVIRONMENT=sandbox
# The id of the webhook (same REST app → Webhooks) that delivers to
#   https://<your shop>/api/payments/paypal/webhook
# It is what lets the shop verify a notification really is PayPal's — until
# it is set, every PayPal webhook is refused.
# PAYPAL_WEBHOOK_ID=

# The shop's one public address — the origin every link the shop hands out
# is built on: where a payment provider sends the customer back to, the
# password-reset and unsubscribe links in emails, back-in-stock links, the
# sitemap. Empty (the default) = whatever address the request arrived on,
# which works, but takes the visitor's word for it. Set it in production:
# links then always carry the real domain, whatever a request claims.
# It must be the exact origin customers use (scheme included, no trailing
# slash) and the shop must answer on that one address only — on any other,
# customers would come back from paying signed out.
# PUBLIC_BASE_URL=https://djinisbakehouse.com

# Dev launcher only (python run.py); production should use the uvicorn CLI
# HOST=127.0.0.1
# PORT=8000
